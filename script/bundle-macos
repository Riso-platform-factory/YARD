#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s [--config <product.toml>] [--out <folder>] [--dev [--env KEY=VALUE]...] [--zip] [-h]\n' "$0"
    printf 'Builds <name>.app from production code. Needs python3 3.11 or newer (tomllib).\n'
    printf 'With --dev, builds a review bundle with a different product name.\n'
    printf 'With --zip, also writes <out>/<name>-<version>.zip, a release, and prints its sha256.\n'
}

step=arguments
die() {
    printf '%s: %s\n' "$step" "$*" >&2
    exit 1
}

config=app/yard/product.toml
out=dist
dev=false
zip=false
bundle_env=()
while (( $# )); do
    case "$1" in
        -h) usage; exit 0 ;;
        --dev) dev=true; shift ;;
        --zip) zip=true; shift ;;
        --env)
            [[ "${2:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "$1 requires KEY=VALUE with a shell-style KEY"
            bundle_env+=("$2")
            shift 2
            ;;
        --config|--out)
            [[ -n "${2:-}" && "$2" != -* ]] || die "$1 requires a path"
            if [[ "$1" == --config ]]; then
                config=$2
            else
                out=$2
            fi
            shift 2
            ;;
        *) die "unknown argument: $1 (use -h for usage)" ;;
    esac
done
if ! "$dev" && [[ -n "${bundle_env[0]:-}" ]]; then
    die "--env requires --dev"
fi
[[ "$config" == /* ]] || config="$PWD/$config"
[[ "$out" == /* ]] || out="$PWD/$out"

temp_dir=
rename() {
    python3 -c 'import os, sys; os.rename(sys.argv[1], sys.argv[2])' "$1" "$2"
}

cleanup() {
    local status=$?
    if (( status != 0 )); then
        printf '%s: failed (exit %s)\n' "$step" "$status" >&2
    fi
    if [[ -n "$temp_dir" ]]; then
        if (( status != 0 )) &&
           [[ -e "$temp_dir/previous" || -L "$temp_dir/previous" ]]; then
            if [[ -e "$destination" || -L "$destination" ]] ||
               ! rename "$temp_dir/previous" "$destination"; then
                printf '%s: previous bundle retained at %s/previous\n' "$step" "$temp_dir" >&2
                return
            fi
        fi
        rm -rf "$temp_dir"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

step=config
values=$(python3 - "$config" "$dev" <<'PY'
import re
import sys
import tomllib

def read_config(path):
    try:
        with open(path, "rb") as source:
            return tomllib.load(source)
    except (OSError, ValueError) as error:
        sys.exit(f"{path}: {error}")

path, dev = sys.argv[1:]
config = read_config(path)
for key in ("name", "version", "identifier", "icon", "url_scheme"):
    value = config.get(key)
    if not isinstance(value, str) or not value.strip():
        sys.exit(f"{path}: missing non-empty `{key}`")
    if any(character in value for character in ("\r", "\n", "\0")):
        sys.exit(f"{path}: `{key}` must fit on one line")
    if key == "url_scheme" and not re.fullmatch(r"[a-z][a-z0-9+.\-]*", value):
        sys.exit(f"{path}: invalid `url_scheme`")
    print(value)
if dev == "true":
    # A review bundle must never take the real product's name, directories,
    # identifier, or URL scheme; macOS compares these without case.
    real = read_config("app/yard/product.toml")
    for key in ("name", "identifier", "url_scheme"):
        if str(config[key]).lower() == str(real.get(key, "")).lower():
            sys.exit(f"{path}: --dev requires a `{key}` different from the production product's")
PY
)
{
    IFS= read -r name
    IFS= read -r version
    IFS= read -r identifier
    IFS= read -r icon
    IFS= read -r url_scheme
} <<< "$values"
case "$name" in
    */*|.|..) die "$config: name must be a single path component" ;;
esac
if "$zip"; then
    case "$version" in
        */*|.|..) die "$config: version must be a single path component with --zip" ;;
    esac
fi
icon="${config%/*}/$icon"
destination="${out%/}/$name.app"

step=stages
printf '%s\n' "$step"
env -u YARD_PROMOTE cargo test -p yard --test stages >&2

step=build
printf '%s\n' "$step"
# The binary's path comes from this build's own report, not from a guessed
# target folder, so a stale binary of another target is never bundled.
if "$dev"; then
    set --
else
    set -- --no-default-features
fi
binary=$(PRODUCT_CONFIG="$config" cargo build --release -p yard --bin yard \
        "$@" --message-format=json-render-diagnostics |
    python3 -c '
import json, sys
paths = [m["executable"] for m in map(json.loads, sys.stdin)
         if m.get("reason") == "compiler-artifact" and m.get("executable")
         and m["target"]["name"] == "yard"]
if not paths:
    sys.exit("cargo reported no yard executable")
print(paths[-1])')

step=icon
printf '%s\n' "$step"
mkdir -p "$out"
temp_dir=$(mktemp -d "${out%/}/.bundle-macos.XXXXXXXX")
iconset="$temp_dir/product.iconset"
mkdir "$iconset"
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" "$icon" --out "$iconset/icon_${size}x${size}.png" >/dev/null
    pixels=$(( size * 2 ))
    sips -z "$pixels" "$pixels" "$icon" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$temp_dir/product.icns" >&2

step=bundle
printf '%s\n' "$step"
bundle="$temp_dir/$name.app"
contents="$bundle/Contents"
mkdir -p "$contents/MacOS" "$contents/Resources"
executable="$contents/MacOS/$name"
if "$dev"; then
    cp "$binary" "$executable-bin"
    cat > "$executable" <<'WRAPPER'
#!/bin/sh
exec "$0-bin" dev "$@"
WRAPPER
    chmod +x "$executable"
else
    cp "$binary" "$executable"
fi
mv "$temp_dir/product.icns" "$contents/Resources/$name.icns"

xml_escape() {
    printf '%s' "$1" | sed -e 's/\&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e $'s/\r/\\&#13;/g'
}
xml_name=$(xml_escape "$name")
xml_version=$(xml_escape "$version")
xml_identifier=$(xml_escape "$identifier")
cat > "$contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>$xml_name</string>
    <key>CFBundleDisplayName</key><string>$xml_name</string>
    <key>CFBundleIdentifier</key><string>$xml_identifier</string>
    <key>CFBundleShortVersionString</key><string>$xml_version</string>
    <key>CFBundleVersion</key><string>$xml_version</string>
    <key>CFBundleExecutable</key><string>$xml_name</string>
    <key>CFBundleIconFile</key><string>$xml_name.icns</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>$xml_identifier</string>
            <key>CFBundleURLSchemes</key><array><string>$url_scheme</string></array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key><string>12.0</string>
    <key>NSHighResolutionCapable</key><true/>
PLIST
if [[ -n "${bundle_env[0]:-}" ]]; then
    {
        printf '    <key>LSEnvironment</key>\n    <dict>\n'
        for pair in "${bundle_env[@]}"; do
            printf '        <key>'
            xml_escape "${pair%%=*}"
            printf '</key><string>'
            xml_escape "${pair#*=}"
            printf '</string>\n'
        done
        printf '    </dict>\n'
    } >> "$contents/Info.plist"
fi
printf '</dict>\n</plist>\n' >> "$contents/Info.plist"
plutil -lint "$contents/Info.plist" >&2

step=sign
printf '%s\n' "$step"
codesign --force --deep --sign - "$bundle" >&2
codesign --verify --deep --strict "$bundle" >&2

step=bundle
if [[ -e "$destination" || -L "$destination" ]]; then
    rename "$destination" "$temp_dir/previous"
fi
rename "$bundle" "$destination"
if "$zip"; then
    step=zip
    printf '%s\n' "$step"
    archive="${out%/}/$name-$version.zip"
    # The bundle is published: a failure from here on must not put the
    # previous one back.
    rm -rf "$temp_dir/previous"
    ditto -c -k --keepParent "$destination" "$temp_dir/release.zip"
    # The digest comes from the staged zip, so no published zip lacks one.
    digest=$(shasum -a 256 < "$temp_dir/release.zip" | cut -d' ' -f1)
    rename "$temp_dir/release.zip" "$archive"
    printf 'sha256 %s\n' "$digest"
fi
printf '%s\n' "$destination"
